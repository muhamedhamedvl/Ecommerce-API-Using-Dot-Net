{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ],
    "Enrich": [ "FromLogContext" ]
  },
  "Hosting": {
    "DisableHttpsRedirection": false
  },
  "Cors": {
    "AllowedOrigins": [ "https://localhost:4200" ]
  },
  "RateLimiting": {
    "PermitLimit": 200,
    "WindowSeconds": 60
  },
  "Redis": {
    "ConnectionString": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "",
    "Audience": "",
    "AccessTokenExpiryMinutes": 60
  }
}
