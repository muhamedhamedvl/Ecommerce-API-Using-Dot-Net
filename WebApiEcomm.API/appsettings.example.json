{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/app-.log",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "Hosting": {
    "DisableHttpsRedirection": false
  },
  "Cors": {
    "AllowedOrigins": [ "https://localhost:4200" ]
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60
  },
  "Redis": {
    "ConnectionString": ""
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=EcommerceDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "EcommerceAPI",
    "Audience": "EcommerceClient",
    "AccessTokenExpiryMinutes": "60"
  },
  "Token": {
    "Secret": "Yasldjkasldhaslhxlnasklldlkasjdlaskjdlkasjkljdklasjkldjklasjzxnaou",
    "Issuer": "EcommerceAPI",
    "Audience": "EcommerceClient",
    "ExpiryDays": "7"
  },
  "Email": {
    "FromName": "E-Commerce",
    "FromAddress": "",
